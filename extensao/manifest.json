{
  "manifest_version": 3,
  "name": "Gringa Radar",
  "version": "0.4.4",
  "description": "Posição no ranking, concorrência e preços do produto direto na página do Mercado Livre. Requer assinatura ativa.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://blnupzfgfhvykrgmvwhw.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png",
      "48": "icones/icone48.png",
      "128": "icones/icone128.png"
    }
  },
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
