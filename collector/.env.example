# ---------------------------------------------------------------------
# Banco — Supabase, "Session pooler" ou "Direct connection".
# Substitua [YOUR-PASSWORD] pela senha real do Postgres.
#
# NAO use a porta 6543 (transaction pooler): nao suporta prepared
# statements e o coletor falha.
#
# O ./setup.sh monta este arquivo com a senha oculta na digitacao.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.blnupzfgfhvykrgmvwhw.supabase.co:5432/postgres
DB_POOL=5

# ---------------------------------------------------------------------
# Aplicacao do Mercado Livre (developers.mercadolivre.com.br)
#
# ML_REDIRECT_URI precisa ser IDENTICA a cadastrada no painel da
# aplicacao. Uma barra a mais devolve invalid_grant.
# ---------------------------------------------------------------------
ML_CLIENT_ID=5716684925480652
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://blnupzfgfhvykrgmvwhw.supabase.co/functions/v1/ml-callback
ML_AUTH_STATE=
ML_SITE_ID=MLB

# Requisicoes por segundo.
#
# Em 24/07/2026 descobrimos que 3,6/seg sustentadas por 30 min fazem o
# endpoint de destaques devolver 200 com lista VAZIA — degradacao em
# silencio, sem 429. A 2,5/seg com pausa, o mesmo endpoint responde
# normalmente. Comece baixo.
ML_RATE_PER_SEC=2

# Pausa entre categorias, em milissegundos. O limitador por segundo nao
# impede rajadas curtas; esta pausa impede.
ML_PAUSA_MS=300

# Quantos anuncios recapturar por rodada diaria.
DAILY_BATCH=20000

